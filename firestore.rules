rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Internal OTP records (never readable/writable by client SDK)
    match /_email_otps/{email} {
      allow read, write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Global Store Slug reservation collection (atomic reservation)
    match /storeSlugs/{slug} {
      // Slugs can be read publicly to check availability
      allow read: if true;
      // Slug can only be created if not exists and ownerId matches caller
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      // Only the owner can update or release their slug
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Store Documents
    match /stores/{storeId} {
      // Store public data can be read for storefront & availability
      allow read: if true;
      
      // Only authenticated users can create stores they own
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Only the store owner can modify or delete store data
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Products subcollection under store
      match /products/{productId} {
        // Products are publicly readable for customers
        allow read: if true;
        
        // Only the store owner can add, modify, or delete products
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }

      // Orders subcollection under store
      match /orders/{orderId} {
        // Customers can create orders; store owners can manage orders
        allow create: if true;
        allow read, update, delete: if request.auth != null && 
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
